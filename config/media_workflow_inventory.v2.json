{
  "version": "2.2",
  "tenant": "media",
  "description": "Kandinsky 5 is the only registered local visual generation model. It handles storyboard images, keyframes, and native image/text-to-video jobs. The GPU router loads one large model at a time; no alternate video engine or interpolation model is enabled.",
  "workflows": [
    {
      "workflow_id": "kandinsky5_local_image",
      "display_name": "Kandinsky 5 Local Image (Storyboard / Keyframe)",
      "engine": "kandinsky5_local",
      "capability": "image_generation",
      "enabled": true,
      "resolution": "768x512",
      "resolution_width": 768,
      "resolution_height": 512,
      "vram_required_mb": 6900,
      "execution_modes": [
        "cuda"
      ],
      "default_mode": "cuda",
      "permitted_job_types": [
        "storyboard_frame",
        "character_reference"
      ]
    },
    {
      "workflow_id": "kandinsky5_local_animation",
      "display_name": "Kandinsky 5 Local Animation (Owner-Preferred)",
      "engine": "kandinsky5_local",
      "capability": "kandinsky_animation",
      "enabled": true,
      "resolution": "768x512",
      "resolution_width": 768,
      "resolution_height": 512,
      "vram_required_mb": 7300,
      "execution_modes": [
        "cuda"
      ],
      "default_mode": "cuda",
      "permitted_job_types": [
        "animation_shot"
      ]
    }
  ]
}
