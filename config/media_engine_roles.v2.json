{
  "version": "2.2",
  "tenant": "media",
  "description": "Kandinsky-only local visual generation for the 8 GB GPU. One large model at a time: Kandinsky batches storyboard/keyframe work, then handles native video jobs. No LTX, Wan, RIFE, or other non-Kandinsky video model is registered or scheduled. Nothing auto-publishes.",
  "vram_safe_limit_mb": 7600,
  "max_concurrent_large_models": 1,
  "engine_roles": {
    "kandinsky5": {
      "role": "native_video_and_storyboard_generation",
      "enabled": true,
      "capabilities": [
        "image_generation",
        "kandinsky_animation",
        "image_to_video",
        "text_to_video"
      ],
      "permitted_job_types": [
        "storyboard_frame",
        "character_reference",
        "animation_shot"
      ],
      "vram_mb": 7300,
      "batch_policy": "use_kandinsky_only_one_large_model_resident_at_a_time"
    },
    "director_local": {
      "role": "director_planning",
      "enabled": true,
      "capabilities": [
        "director_planning"
      ],
      "permitted_job_types": [
        "director_shot_plan"
      ],
      "batch_policy": "planning_only_no_gpu_model_load"
    },
    "editor_local": {
      "role": "editor_review",
      "enabled": true,
      "capabilities": [
        "editor_review"
      ],
      "permitted_job_types": [
        "edit_decision"
      ],
      "batch_policy": "review_only_no_gpu_model_load"
    }
  },
  "batch_routing_policy": {
    "prohibited_patterns": [
      "per_shot_engine_alternation",
      "wan_14B_model_scheduling",
      "auto_publish_from_pipeline",
      "non_kandinsky_video_model_scheduling"
    ],
    "sequence": [
      {
        "step": 1,
        "engine": "kandinsky5",
        "phase": "storyboard_batch",
        "gate": "script_approved",
        "description": "Batch all Kandinsky storyboard frames and keyframes before native video generation."
      },
      {
        "step": 2,
        "engine": "kandinsky5",
        "phase": "native_video_batch",
        "gate": "storyboard_approved",
        "description": "Generate approved animation shots with Kandinsky 5 only."
      },
      {
        "step": 3,
        "phase": "final_qc_handoff",
        "gate": "edit_ready_do_not_publish",
        "description": "Pipeline terminates at edit_ready. No automatic public publishing occurs."
      }
    ]
  }
}
